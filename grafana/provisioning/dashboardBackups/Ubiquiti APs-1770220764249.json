        "pluginVersion": "12.3.1",
        "repeat": "AP_Instances",
        "repeatDirection": "v",
        "targets": [
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "editorMode": "code",
            "expr": "rate(ifInOctets{instance=~\"$AP_Instances\", ifDescr=\"ath0\"}[3m]) * 8\r\n* on(instance) group_left(sysName) \r\n(max by(instance, sysName) (sysName) * 0 + 1)",
            "instant": false,
            "legendFormat": "In |  {{ifDescr}} - {{sysName}}",
            "range": true,
            "refId": "A"
          },
          {
            "datasource": {
              "type": "prometheus",
              "uid": "PBFA97CFB590B2093"
            },
            "editorMode": "code",
            "expr": "rate(ifOutOctets{instance=~\"$AP_Instances\", ifDescr=\"ath0\"}[3m]) * 8\r\n* on(instance) group_left(sysName) \r\n(max by(instance, sysName) (sysName) * 0 + 1)",
            "hide": false,
            "instant": false,
            "legendFormat": "Out | {{ifDescr}} - {{sysName}}",
            "range": true,
            "refId": "B"
          }
        ],
        "title": "AP $AP_Instances Traffic",
        "type": "timeseries"
      }
